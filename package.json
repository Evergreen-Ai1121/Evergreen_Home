{
  "name": "evergreen-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-search-index.mjs && node scripts/sync-content-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-content.mjs && node scripts/build-search-index.mjs && node scripts/sync-content-images.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "search-index": "node scripts/build-search-index.mjs",
    "content-images": "node scripts/sync-content-images.mjs",
    "font:subset": "node scripts/subset-brand-font.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:content": "node scripts/check-content.mjs",
    "test:http": "node tests/http-smoke.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "katex": "^0.19.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^1.24.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "postcss": "^8.5.23",
    "prettier": "^3.9.10",
    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "katex": "$katex",
    "postcss": "$postcss"
  }
}
