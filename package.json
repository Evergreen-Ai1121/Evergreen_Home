{
  "name": "evergreen-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-search-index.mjs && node scripts/sync-content-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-search-index.mjs && node scripts/sync-content-images.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "search-index": "node scripts/build-search-index.mjs",
    "content-images": "node scripts/sync-content-images.mjs",
    "font:charset": "node scripts/build-font-charset.mjs",
    "font:subset": "node scripts/build-font-charset.mjs && node scripts/subset-display-font.mjs",
    "db:init": "node scripts/init-db.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@mdx-js/mdx": "^3.1.1",
    "clsx": "^2.1.1",
    "cos-nodejs-sdk-v5": "^2.14.0",
    "fuse.js": "^7.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "katex": "^0.16.11",
    "lucide-react": "^0.469.0",
    "next": "^15.5.27",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^1.24.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
