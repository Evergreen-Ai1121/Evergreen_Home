# ── 站点 ──────────────────────────────────────────────
# 部署后的正式域名（用于 sitemap / OG 绝对链接）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── 管理端（说说） ─────────────────────────────────────
# /admin 登录令牌，同时用作会话 Cookie 的签名密钥。请设为足够长的随机串。
ADMIN_TOKEN=change-me-to-a-long-random-string

# ── 数据库（Turso / libSQL） ───────────────────────────
# 不配置时说说列表为空，其余页面不受影响
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# ── 对象存储（腾讯云 COS） ─────────────────────────────
# 永久密钥仅用于服务端签发临时上传 URL，不会下发浏览器
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-guangzhou
# 图片公网访问域名（可填 CDN / 自定义域名），不填则回退 COS 默认域名
NEXT_PUBLIC_COS_BASE_URL=
# 是否开启数据万象（开启后列表使用 WebP 缩略图）
NEXT_PUBLIC_COS_IMAGE_CI=1

# ── 评论（自建，存 Turso） ────────────────────────────
# 与这个邮箱相同的评论会被标记「作者」徽章；不配就不显示徽章（不会下发到浏览器）
AUTHOR_EMAIL=you@example.com

# ── 评论（giscus） ────────────────────────────────────
# 在 https://giscus.app/zh-CN 配置后取得
NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
